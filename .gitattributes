# Stable text checkouts; source fingerprints always refer to exact raw bytes.
* text=auto
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.bat text eol=crlf
# Preserve byte-addressed sources and historical artifacts.
fixtures/**/*.py -text !eol
benchmarks/core/submissions/*.py -text !eol
results/** -text !eol
# Evidence inventories hash exact bytes, including CSV and Windows test logs.
docs/v4-evidence/** -text !eol

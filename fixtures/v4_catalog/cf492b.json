    "title": "492B · Vanya and Lanterns",
    "statement": "شارع طوله l عليه n مصباحًا. احسب أصغر نصف قطر إضاءة مشترك يغطي الشارع كله.\nالسطر الأول يحوي n وl، والثاني يحوي n موقعًا بين 0 وl. قد تتكرر المواقع وترد بأي ترتيب. اطبع قيمة عددية واحدة.",
    "schema_version": 2,
    "fields": [
      {
        "name": "n",
        "kind": "int",
        "min": 1,
        "max": 1000
      },
      {
        "name": "length",
        "kind": "int",
        "min": 1,
        "max": 1000000000
      },
      {
        "name": "positions",
        "kind": "ints",
        "min": 0,
        "max": 1000000000,
        "length_from": "n",
        "max_from": "length"
      }
    ],
    "lines": [

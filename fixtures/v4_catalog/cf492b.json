        "n",
        "length"
      ],
      [
        "positions"
      ]
    ],
    "output": "float_tokens",
    "output_count": 1,
    "tolerance": {
      "abs": 1e-09,
      "rel": 1e-09
    },
    "relative_to": "expected"
  },
  "reference": "n, length = map(int, input().split())\npositions = sorted(map(int, input().split()))\ninner = max((b - a for a, b in zip(positions, positions[1:])), default=0)\ntwice = max(2 * positions[0], 2 * (length - positions[-1]), inner)\nprint(f'{twice // 2}.{5 if twice % 2 else 0}')\n",
